DATABASE_URL=postgresql://jobscraper:jobscraper@localhost:5432/jobscraper
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
RABBITMQ_URL=amqp://jobscraper:jobscraper@localhost:5672
RABBITMQ_QUEUE=scrape_jobs

# The FastAPI scraper, which also renders and scores resumes. The browser never
# calls it directly — Next route handlers proxy every request.
SCRAPER_URL=http://localhost:8000
# Must match INTERNAL_API_TOKEN in scraper/.env.
SCRAPER_TOKEN=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
