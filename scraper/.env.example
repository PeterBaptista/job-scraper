RABBITMQ_URL=amqp://jobscraper:jobscraper@localhost:5672/
DATABASE_URL=postgresql://jobscraper:jobscraper@localhost:5432/jobscraper
SCRAPE_QUEUE=scrape_jobs
COOKIES_DIR=cookies

# Telegram notifications — new jobs are pushed here after each scrape.
# Create a bot with @BotFather to get the token, then message your bot once and
# run: uv run python scripts/telegram_chat_id.py
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Run headed Chrome inside a virtual display. Required in containers (no monitor);
# leave false on a desktop. Headless is deliberately NOT used — it is easy to detect.
BROWSER_XVFB=false

# Scrape scheduler (jittered, so runs don't fire on a fixed clock).
# NOTE: docker-compose.yml overrides these with 30 ± 8 min for the container.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_JITTER_MINUTES=12
SCHEDULER_SOURCE=linkedin
# LinkedIn f_TPR window — 7200 = only jobs posted in the last 2h
SCHEDULER_TIME_POSTED_SECONDS=7200
# Leave blank to use the only registered user; required if you have more than one
SCHEDULER_USER_EMAIL=

# OpenAI. Tailoring uses the stronger model (its wording reaches employers);
# external-form field mapping uses the cheaper one (mechanical label->value work).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_FORM_MODEL=gpt-5-mini

# Companies never shown in Telegram (comma-separated, substring match)
BLOCKED_COMPANIES=

# Shared secret for the resume API used by the dashboard. Blank disables those
# endpoints entirely rather than serving them open — port 8000 is published.
INTERNAL_API_TOKEN=change-me
# Where Telegram cards deep-link for editing a CV.
DASHBOARD_URL=http://localhost:3000
